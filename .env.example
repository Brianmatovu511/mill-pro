# ── Database (Neon PostgreSQL recommended) ──
# Get yours at https://neon.tech
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# ── Server ──
PORT=5000
NODE_ENV=development

# ── JWT ──
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-min-32-chars
JWT_EXPIRES_IN=7d

# ── Frontend (production only) ──
CLIENT_URL=http://localhost:5173

# ── Super Admin (seeded once on first boot) ──
SUPER_ADMIN_EMAIL=admin@millpro.app
SUPER_ADMIN_PASSWORD=ChangeThisStrongPassword!2026
SUPER_ADMIN_NAME=MillPro Administrator

# ── AI Advisor (Claude) ──
# Get your API key at https://console.anthropic.com
# If unset, the AI features show a graceful "not configured" message instead of crashing.
ANTHROPIC_API_KEY=